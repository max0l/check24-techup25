{
    "swagger": "2.0",
    "info": {
        "title": "Techup25",
        "contact": {}
    },
    "host": "localhost:8080",
    "paths": {
        "/hotel/{hotelid}": {
            "get": {
                "description": "handles hotel requests and returns the hotel information.",
                "summary": "handles hotel requests",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID of the hotel",
                        "name": "hotelid",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Hotel information",
                        "schema": {
                            "type": "body"
                        }
                    },
                    "400": {
                        "description": "Bad Request"
                    },
                    "404": {
                        "description": "Hotel Not Found"
                    }
                }
            }
        },
        "/offers": {
            "get": {
                "description": "handles offer requests and returns a list of offers.",
                "summary": "handles offer requests",
                "parameters": [
                    {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "collectionFormat": "csv",
                        "description": "List of departure airports, e.g. FRA, MUC",
                        "name": "DepartureAirports",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Earliest departure date in format RFC3339",
                        "name": "EarliestDepartureDate",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Latest return date in format RFC3339",
                        "name": "LatestReturnDate",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Number of adults",
                        "name": "CountAdults",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Number of children",
                        "name": "CountChildren",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Duration of the trip in days",
                        "name": "Duration",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Site, e.g. 1 or 2",
                        "name": "Site",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "List of offers matching the request",
                        "schema": {
                            "type": "body"
                        }
                    },
                    "400": {
                        "description": "Bad Request"
                    },
                    "404": {
                        "description": "No Offers Found"
                    }
                }
            }
        }
    }
}