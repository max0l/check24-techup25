{
    "swagger": "2.0",
    "info": {
        "title": "Techup25",
        "contact": {}
    },
    "host": "localhost:8080",
    "paths": {
        "/hotel/{hotelid}": {
            "get": {
                "description": "handles hotel requests and returns the hotel information.",
                "summary": "handles hotel requests",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID of the hotel",
                        "name": "hotelid",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Site, e.g. 1 or 2",
                        "name": "site",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "collectionFormat": "csv",
                        "description": "List of departure airports, e.g. FRA, MUC",
                        "name": "departureAirports",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Earliest departure date in format RFC3339",
                        "name": "earliestDepartureDate",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Latest return date in format RFC3339",
                        "name": "latestReturnDate",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Number of adults",
                        "name": "countAdults",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Number of children",
                        "name": "countChildren",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Duration of the trip in days",
                        "name": "duration",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Hotel information",
                        "schema": {
                            "$ref": "#/definitions/data.HotelResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request"
                    },
                    "404": {
                        "description": "Hotel Not Found"
                    }
                }
            }
        },
        "/offers": {
            "get": {
                "description": "handles offer requests and returns a list of offers.",
                "summary": "handles offer requests",
                "parameters": [
                    {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "collectionFormat": "csv",
                        "description": "List of departure airports, e.g. FRA, MUC",
                        "name": "departureAirports",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Earliest departure date in format RFC3339",
                        "name": "earliestDepartureDate",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Latest return date in format RFC3339",
                        "name": "latestReturnDate",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Number of adults",
                        "name": "countAdults",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Number of children",
                        "name": "countChildren",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Duration of the trip in days",
                        "name": "duration",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Site, e.g. 1 or 2",
                        "name": "site",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "List of offers matching the request",
                        "schema": {
                            "$ref": "#/definitions/data.OfferResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request"
                    },
                    "404": {
                        "description": "No Offers Found"
                    }
                }
            }
        }
    },
    "definitions": {
        "data.HotelResponse": {
            "type": "object",
            "properties": {
                "count_available_offers": {
                    "type": "integer"
                },
                "hotelid": {
                    "type": "integer"
                },
                "hotelname": {
                    "type": "string"
                },
                "hotelstars": {
                    "type": "number"
                },
                "offers": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/data.Offer"
                    }
                }
            }
        },
        "data.Offer": {
            "type": "object",
            "properties": {
                "countadults": {
                    "type": "integer"
                },
                "countchildren": {
                    "type": "integer"
                },
                "durationindays": {
                    "type": "integer"
                },
                "hotelid": {
                    "type": "integer"
                },
                "inboundarrivalairport": {
                    "type": "string"
                },
                "inboundarrivaldatetime": {
                    "type": "string"
                },
                "inbounddepartureairport": {
                    "type": "string"
                },
                "inbounddeparturedatetime": {
                    "type": "string"
                },
                "mealtype": {
                    "type": "string"
                },
                "oceanview": {
                    "type": "boolean"
                },
                "offerid": {
                    "type": "integer"
                },
                "outboundarrivalairport": {
                    "type": "string"
                },
                "outboundarrivaldatetime": {
                    "type": "string"
                },
                "outbounddepartureairport": {
                    "type": "string"
                },
                "outbounddeparturedatetime": {
                    "type": "string"
                },
                "price": {
                    "type": "number"
                },
                "roomtype": {
                    "type": "string"
                }
            }
        },
        "data.OfferResponse": {
            "type": "object",
            "properties": {
                "countOffers": {
                    "type": "integer",
                    "example": 5
                },
                "offers": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/data.OfferWithHotel"
                    }
                }
            }
        },
        "data.OfferWithHotel": {
            "type": "object",
            "properties": {
                "countadults": {
                    "type": "integer",
                    "example": 2
                },
                "countchildren": {
                    "type": "integer",
                    "example": 1
                },
                "durationindays": {
                    "type": "integer",
                    "example": 7
                },
                "hotelid": {
                    "type": "integer",
                    "example": 123
                },
                "hotelname": {
                    "type": "string",
                    "example": "Hotel Sunshine"
                },
                "hotelstars": {
                    "type": "number",
                    "example": 4.5
                },
                "inboundarrivalairport": {
                    "type": "string",
                    "example": "PMI"
                },
                "inboundarrivaldatetime": {
                    "type": "string",
                    "example": "2025-12-31T00:00:00+02:00"
                },
                "inbounddepartureairport": {
                    "type": "string",
                    "example": "BER"
                },
                "inbounddeparturedatetime": {
                    "type": "string",
                    "example": "2025-12-31T00:00:00+02:00"
                },
                "mealtye": {
                    "type": "string",
                    "example": "allinclusive"
                },
                "ocenview": {
                    "type": "boolean",
                    "example": true
                },
                "outboundarrivalairport": {
                    "type": "string",
                    "example": "BER"
                },
                "outboundarrivaldatetime": {
                    "type": "string",
                    "example": "2025-01-01T00:00:00+02:00"
                },
                "outbounddepartureairport": {
                    "type": "string",
                    "example": "PMI"
                },
                "outbounddeparturedatetime": {
                    "type": "string",
                    "example": "2025-01-01T00:00:00+02:00"
                },
                "price": {
                    "type": "number",
                    "example": 299.99
                },
                "rommtype": {
                    "type": "string",
                    "example": "double"
                }
            }
        }
    }
}